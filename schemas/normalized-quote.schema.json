{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yigitcan-ozturk/currency-normalizer/schemas/normalized-quote.schema.json",
  "title": "currency-normalizer normalized quotation",
  "type": "object",
  "required": ["name", "currency", "price", "lead_time_weeks", "payment_days", "normalization"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "lead_time_weeks": {"type": "number", "exclusiveMinimum": 0},
    "payment_days": {"type": "number", "minimum": 0},
    "normalization": {
      "type": "object",
      "required": ["schema", "schema_version", "tool", "version", "original_price", "original_currency", "target_currency", "rate", "rate_date", "normalized_price", "rate_source"],
      "properties": {
        "schema": {"const": "currency-normalizer.normalization"},
        "schema_version": {"const": "1.0"},
        "tool": {"const": "currency-normalizer"},
        "version": {"type": "string"},
        "original_price": {"type": "string"},
        "original_currency": {"type": "string"},
        "target_currency": {"type": "string"},
        "rate": {"type": "string"},
        "rate_date": {"type": "string"},
        "normalized_price": {"type": "string"},
        "rate_source": {
          "type": "object",
          "required": ["service", "service_url", "selection", "provider"],
          "properties": {
            "service": {"const": "Frankfurter"},
            "service_url": {"const": "https://frankfurter.dev"},
            "selection": {"enum": ["blended", "pinned", "same_currency"]},
            "provider": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

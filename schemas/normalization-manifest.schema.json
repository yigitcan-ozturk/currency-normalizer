{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yigitcan-ozturk/currency-normalizer/schemas/normalization-manifest.schema.json",
  "title": "currency-normalizer batch normalization manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "tool",
    "version",
    "run_id",
    "portfolio_id",
    "policy",
    "policy_sha256",
    "target_currency",
    "requested_rate_date",
    "rate_source",
    "files"
  ],
  "properties": {
    "schema": {"const": "currency-normalizer.manifest"},
    "schema_version": {"const": "1.0"},
    "tool": {"const": "currency-normalizer"},
    "version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^cn-[0-9a-f]{20}$"},
    "portfolio_id": {"type": ["string", "null"], "maxLength": 120},
    "policy": {
      "type": "object",
      "required": ["schema", "schema_version", "base_currency", "rate_date", "provider", "portfolio_id"],
      "properties": {
        "schema": {"const": "currency-normalizer.portfolio-policy"},
        "schema_version": {"const": "1.0"},
        "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "rate_date": {"type": ["string", "null"], "format": "date"},
        "provider": {"type": ["string", "null"]},
        "portfolio_id": {"type": ["string", "null"], "maxLength": 120}
      },
      "additionalProperties": false
    },
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "requested_rate_date": {"type": ["string", "null"]},
    "rate_source": {
      "type": "object",
      "required": ["service", "service_url", "selection", "provider"],
      "properties": {
        "service": {"const": "Frankfurter"},
        "service_url": {"const": "https://frankfurter.dev"},
        "selection": {"enum": ["blended", "pinned", "same_currency", "mixed"]},
        "provider": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "source_sha256", "output", "output_sha256", "supplier"],
        "properties": {
          "source": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output": {"type": "string"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "supplier": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
